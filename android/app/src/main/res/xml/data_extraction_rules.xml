<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e posteriores: mesma regra, para o backup na nuvem e para a transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/IndexedDB" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/IndexedDB" />
    </device-transfer>
</data-extraction-rules>
